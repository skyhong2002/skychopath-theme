<div class="gh-social-links skychopath-social-links">
    {{~#social_accounts @site~}}
        {{~#match type "!=" "x"~}}
            {{~#match type "!=" "facebook"~}}
                <a href="{{href}}" target="_blank" rel="noopener" aria-label="{{name}}">
                    {{#> (concat "icons/" type)}}
                        <span>{{name}}</span>
                    {{/undefined}}
                </a>
            {{~/match~}}
        {{~/match~}}
    {{~/social_accounts~}}
</div>
